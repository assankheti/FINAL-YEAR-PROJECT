# Copy these keys into Render > your backend service > Environment.
# Keep real secrets in Render only. Do not commit filled values.

PYTHON_VERSION=3.11.11
PYTHONUNBUFFERED=1
PYTHONPATH=src
UPLOAD_ROOT=/var/data/uploads

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=dbasssankheti

STYTCH_PROJECT_ID=project-live-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
STYTCH_SECRET=secret-live-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STYTCH_ENV=live
STYTCH_ENVIRONMENT=live

STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=replace_with_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_ADMIN_MOBILE_IDS=admin-001,admin-002
PLATFORM_COMMISSION_RATE=0.10
PLATFORM_SERVICE_FEE_PKR=100

FRONTEND_URL=https://your-frontend-domain.example
API_URL=https://assan-kheti-backend.onrender.com

STREAM_APP_ID=your_stream_app_id
STREAM_API_KEY=your_stream_public_api_key
STREAM_API_SECRET=your_stream_server_secret
STREAM_ADMIN_MOBILE_IDS=admin-001,admin-002

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional. The chatbot endpoint falls back when this is missing.
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-3.5-turbo
